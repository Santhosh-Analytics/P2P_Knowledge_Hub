 document_id=UUID('082666da-7e3c-43e6-82cb-fb2022df00ed') document_group_id=UUID('6a8442e5-970b-44b7-b0ad-3b2d8762367e') document_name='Chapter 8 University Procurement Services Procedures Manual.pdf' document_status=<DocumentStatus.UPLOADED: 'uploaded'> document_version=1 source_system=<SourceSystem.SAP: 'SAP'> business_process=<BusinessProcess.PAYMENT: 'PAYMENT'> uploaded_at=datetime.datetime(2026, 8, 28, 19, 1, 39, 972949, tzinfo=datetime.timezone.utc) uploaded_by='PayOut Policy' department=<Department.ACCOUNTS_PAYABLE: 'ACCOUNTS_PAYABLE'> source_uri='/home/san/Projects/P2P_Knowledge_Hub/data/raw/Chapter 8 University Procurement Services Procedures Manual.pdf' file_hash='155b416ba575710362b7d06b73a682fa9d9ea603b2ebf767fa78077638e948a8' file_size_bytes=328200 mime_type=<MimeType.PDF: 'application/pdf'> source_document_key=<SourceDocumentKey.PAYMENT_POLICY: 'PAYMENT_POLICY'>
