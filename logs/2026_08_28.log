 document_id=UUID('1d46fba5-317e-4d44-b81f-bca02c3033c1') document_group_id=UUID('8a86c968-cad0-4483-933f-853b8bef954b') document_name='Chapter 6 University Procurement Services Procedures Manual.pdf' document_status=<DocumentStatus.UPLOADED: 'uploaded'> document_version=1 source_system=<SourceSystem.SAP: 'SAP'> business_process=<BusinessProcess.PURCHASEORDER: 'PURCHASEORDER'> uploaded_at=datetime.datetime(2026, 8, 28, 19, 0, 48, 447329, tzinfo=datetime.timezone.utc) uploaded_by='PayOut Policy' department=<Department.PROCUREMENT: 'PROCUREMENT'> source_uri='/home/san/Projects/P2P_Knowledge_Hub/data/raw/Chapter 6 University Procurement Services Procedures Manual.pdf' file_hash='9aafc69bdfd2452dc932d126e99d2ec1791a796054e50202d3765f7ecf7ea24e' file_size_bytes=226749 mime_type=<MimeType.PDF: 'application/pdf'> source_document_key=<SourceDocumentKey.PURCHASE_ORDER_SOP: 'PURCHASE_ORDER_SOP'>
