 document_id=UUID('d0d68615-675f-40e8-b0e9-d3c1945841af') document_group_id=UUID('10542897-471a-44e0-9b27-e33afe74999b') document_name='Chapter 2 University Procurement Services Procedures Manual_0.pdf' document_status=<DocumentStatus.UPLOADED: 'uploaded'> document_version=1 source_system=<SourceSystem.ORACLE: 'ORACLE'> business_process=<BusinessProcess.SUPPLIER_ONBOARDING: 'SUPPLIER_ONBOARDING'> uploaded_at=datetime.datetime(2026, 8, 28, 19, 14, 10, 455647, tzinfo=datetime.timezone.utc) uploaded_by='SOP' department=<Department.SUPPLIER_MANAGEMENT: 'SUPPLIER_MANAGEMENT'> source_uri='/home/san/Projects/P2P_Knowledge_Hub/data/raw/Chapter 2 University Procurement Services Procedures Manual_0.pdf' file_hash='689da4dcbcac5da3d33ffca540c9b123b530c57aa7bf36cbb7b80619772117e5' file_size_bytes=329129 mime_type=<MimeType.PDF: 'application/pdf'> source_document_key=<SourceDocumentKey.SUPPLIER_ONBOARDING_POLICY: 'SUPPLIER_ONBOARDING_POLICY'>
