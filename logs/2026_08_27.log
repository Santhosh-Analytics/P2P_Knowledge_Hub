 document_id=UUID('1515baf9-5995-4e8a-8585-81a2f6035458') document_group_id=UUID('c9c5b0c8-bc37-4f3a-a779-8bcd7fc31e7a') document_name='SOP Accounts - Payable.pdf' document_status=<DocumentStatus.UPLOADED: 'uploaded'> document_version=1 source_system=<SourceSystem.SAP: 'SAP'> business_process=<BusinessProcess.SUPPLIER_ONBOARDING: 'SUPPLIER_ONBOARDING'> uploaded_at=datetime.datetime(2026, 8, 27, 18, 32, 59, 689248, tzinfo=datetime.timezone.utc) uploaded_by='string' department=<Department.ACCOUNTS_PAYABLE: 'ACCOUNTS_PAYABLE'> source_uri='/home/san/Projects/P2P_Knowledge_Hub/data/raw/SOP Accounts - Payable.pdf' file_hash='b3e9df560863de97cd2d2cf8d986da49b4641aaeaf12d0ea8565c895140dafa6' file_size_bytes=112224 mime_type=<MimeType.PDF: 'application/pdf'> source_document_key=<SourceDocumentKey.SUPPLIER_ONBOARDING_POLICY: 'SUPPLIER_ONBOARDING_POLICY'>
