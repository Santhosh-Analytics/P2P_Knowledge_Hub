, section=None, title=None), DocumentChunk(chunk_id=UUID('b6838b91-d665-498b-841a-534d81a905d4'), chunk_index=24, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27230, tzinfo=datetime.timezone.utc), text='Mass Editing a Shopping Cart. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .14', page_no=2, section=None, title=None), DocumentChunk(chunk_id=UUID('c0001540-dae4-4321-99d8-94a8f1cf27bf'), chunk_index=25, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27234, tzinfo=datetime.timezone.utc), text='Mass Editing of Partial Items. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . 15', page_no=2, section=None, title=None), DocumentChunk(chunk_id=UUID('758d28bb-2c5e-48bf-a870-e976e8c4fa2a'), chunk_index=26, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27238, tzinfo=datetime.timezone.utc), text='Mass Editing Collaboration Options in a Shopping Cart for Goods Items. . . . . . . . . . . . . . . . . . . . . . . . . 15', page_no=2, section=None, title=None), DocumentChunk(chunk_id=UUID('e138ef3e-99a6-4ef7-abd9-9aee75c6f406'), chunk_index=27, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27242, tzinfo=datetime.timezone.utc), text='Checking Out the Shopping Cart. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .17', page_no=2, section=None, title=None), DocumentChunk(chunk_id=UUID('3669f2c5-b386-4438-a0f2-8fca2af8d7b9'), chunk_index=28, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27246, tzinfo=datetime.timezone.utc), text='Saving a Shopping Cart. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . 18', page_no=2, section=None, title=None), DocumentChunk(chunk_id=UUID('7d84901e-e684-4da4-82b3-b31358ab6938'), chunk_index=29, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27250, tzinfo=datetime.timezone.utc), text='Finding a Saved Shopping Cart. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . 19', page_no=2, section=None, title=None), DocumentChunk(chunk_id=UUID('8e4cbca1-1612-468d-963f-d97575a257ba'), chunk_index=30, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27254, tzinfo=datetime.timezone.utc), text='Shopping Cart Search Filters. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . 19', page_no=2, section=None, title=None), DocumentChunk(chunk_id=UUID('7531e8e4-4e31-49de-b509-b6726d0535f0'), chunk_index=31, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27258, tzinfo=datetime.timezone.utc), text='Copying a Saved Shopping Cart. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . 20\n2\nPUBLIC\nShopping Cart User Guide\nContent', page_no=2, section=None, title=None), DocumentChunk(chunk_id=UUID('ebfad27e-b6db-424c-ba9d-7249c9f4f0eb'), chunk_index=32, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27264, tzinfo=datetime.timezone.utc), text='Deleting a Saved Shopping Cart. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . 21\nShopping Cart User Guide\nContent\nPUBLIC\n3', page_no=3, section=None, title=None), DocumentChunk(chunk_id=UUID('ae0067f2-cc03-4d70-b8bf-92c1c4c561e8'), chunk_index=33, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27294, tzinfo=datetime.timezone.utc), text='Shopping Cart User Guide\nThis guide is for SAP Ariba Catalog users seeking information on how to add items to and manage procurement\nshopping carts.\nBuyer users punch in to SAP Ariba Catalog from external systems, add items to and checkout shopping carts.\nThis guide applies to:\n•\nSAP Ariba Catalog\nRelated guides\nCustomer Catalog User Guide\nCustomer Catalog Administration Guide for Buyers\n4\nPUBLIC\nShopping Cart User Guide', page_no=4, section=None, title=None), DocumentChunk(chunk_id=UUID('35a5901d-bc5c-44a9-bbb1-85f2cec8008f'), chunk_index=34, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27298, tzinfo=datetime.timezone.utc), text='Shopping Cart User Guide', page_no=4, section=None, title=None), DocumentChunk(chunk_id=UUID('06dd1c62-505d-4917-bb27-61cce92b38c1'), chunk_index=35, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27372, tzinfo=datetime.timezone.utc), text='Shopping Carts\nA shopping cart is a document to which you add items that you want to purchase. Each shopping cart is assigned a\nunique ID (such as SH1234) to identify and track it as it moves through the shopping process.\nA new shopping cart is automatically created when you punch in to SAP Ariba Catalog. You can access your current', page_no=5, section=None, title=None), DocumentChunk(chunk_id=UUID('3f31809a-66de-4673-ad7c-af3bde5b670c'), chunk_index=36, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27376, tzinfo=datetime.timezone.utc), text='shopping cart any time by clicking the Cart icon on the toolbar.\nRelated Information\nWorkflow of the Shopping Process [page 5]\nPunchIn Modes and Available Actions [page 6]\nWorkflow of the Shopping Process\nThe workflow of the shopping process involves the following basic steps:\n1.\nPunch in to SAP Ariba Catalog.\nThe Catalog Home Page is displayed and a new shopping cart is automatically created. To view previously', page_no=5, section=None, title=None), DocumentChunk(chunk_id=UUID('b517d1fc-b0fe-4692-bba3-bb2e5d5ac6a4'), chunk_index=37, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27380, tzinfo=datetime.timezone.utc), text='saved shopping carts, click Saved Carts on the toolbar.\n2. Browse the customer catalog to add items to the shopping cart or add non-catalog items to the shopping cart.\n3. To view the contents of the current cart, click the Cart button, and then click Review Cart.\n4. Review your items, edit or delete items and click Checkout to check out the cart to your external procurement\nsystem.', page_no=5, section=None, title=None), DocumentChunk(chunk_id=UUID('4eab010f-94ad-4b32-adc8-da515c1e5aef'), chunk_index=38, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27384, tzinfo=datetime.timezone.utc), text='The actions that you can perform in SAP Ariba Catalog depend on the mode that you punch in. You can punch\nin to SAP Ariba Catalog in one of the following modes:\n•\nCreate mode\n•\nEdit mode\n•\nInspect mode\nThe functionality of saving shopping carts in SAP Ariba Catalog is available in the default configuration. You cannot\nsave shopping carts if this functionality is disabled for your site.', page_no=5, section=None, title=None), DocumentChunk(chunk_id=UUID('ada780b9-ccf8-4252-882b-6ad1966f3e96'), chunk_index=39, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27388, tzinfo=datetime.timezone.utc), text='Shopping Cart User Guide\nShopping Carts\nPUBLIC\n5', page_no=5, section=None, title=None), DocumentChunk(chunk_id=UUID('8d8ebbec-ed42-4182-9f39-1f49a7b49aad'), chunk_index=40, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27429, tzinfo=datetime.timezone.utc), text='PunchIn Modes and Available Actions\nPunchIn Mode\nActions you can perform\nCreate\nA new shopping cart is automatically created when you punch in the create mode.\nYou can check out or save the current cart. Click the Saved Carts button to view the carts that you\npreviously saved.\nEdit\nYou punch in to SAP Ariba Catalog with a unique shopping cart title. Only the associated shopping\ncart is displayed.', page_no=6, section=None, title=None), DocumentChunk(chunk_id=UUID('2f93081e-7efb-43ae-978d-1c6ec99b797a'), chunk_index=41, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27433, tzinfo=datetime.timezone.utc), text='You can edit the cart and check out the cart or save the cart and exit SAP Ariba Catalog.\nYou cannot view your previously saved carts or create new carts.\nInspect\nYou punch in to SAP Ariba Catalog with a unique shopping cart title. Only the associated shopping\ncart is displayed.\nYou cannot edit the shopping cart, but can make a copy it.', page_no=6, section=None, title=None), DocumentChunk(chunk_id=UUID('ccc18d3f-8c4b-4f42-9915-136091840212'), chunk_index=42, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27437, tzinfo=datetime.timezone.utc), text='You can then edit the copied shopping cart and either check out or save the cart in SAP Ariba\nCatalog and exit to your external procurement system.\nYou cannot view your previously saved carts or create new carts.\n6\nPUBLIC\nShopping Cart User Guide\nShopping Carts', page_no=6, section=None, title=None), DocumentChunk(chunk_id=UUID('6f546baf-36ee-4969-a9b3-f2740acf940b'), chunk_index=43, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27489, tzinfo=datetime.timezone.utc), text='Shopping Carts Management\nCreating Shopping Carts\nPrerequisites\nA new shopping cart is automatically created when you punch in to SAP Ariba Catalog.\n\ue05c\xa0Note\nOn the Review Cart page, if you change the quantity of a kit item at the header level, only those kit items that\nare configured as required are updated. The quantity of optional kit items is not updated. You must update the', page_no=7, section=None, title=None), DocumentChunk(chunk_id=UUID('30deac02-44b4-474d-a1cf-88c3516fb63f'), chunk_index=44, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27493, tzinfo=datetime.timezone.utc), text='quantity for these items manually if required.\nProcedure\n1.\nPunch in to SAP Ariba Catalog. The customer catalog home page is displayed and a new shopping cart is\ncreated.\n2. Add items to the shopping cart by searching or browsing for items in the customer catalog home page.\nFor information on using the customer catalog, see Customer Catalog User Guide.', page_no=7, section=None, title=None), DocumentChunk(chunk_id=UUID('ddc165a6-c529-4bea-9244-e57a296de005'), chunk_index=45, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27497, tzinfo=datetime.timezone.utc), text='3. Click the Cart icon and click Review Cart to view the shopping cart contents.\nAdding a Single Customer Catalog Item to the\nShopping Cart\nContext\nIn the customer catalog search results page an Add to Cart button is available for each local customer catalog\nitem. When you add items, a pop-up displays the details of the items that you have added recently.\nProcedure\nDo one of the following:', page_no=7, section=None, title=None), DocumentChunk(chunk_id=UUID('764938d2-129c-479f-a561-2018d635c6b3'), chunk_index=46, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27501, tzinfo=datetime.timezone.utc), text='Shopping Cart User Guide\nShopping Carts Management\nPUBLIC\n7', page_no=7, section=None, title=None), DocumentChunk(chunk_id=UUID('5d0f068a-96c1-44b5-908c-3dd4a25528ee'), chunk_index=47, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27574, tzinfo=datetime.timezone.utc), text='•\nFor the item you want to add to the shopping cart, enter the quantity that you want to order, and click Add to\nCart.\n•\nClick an item link to view the item details, enter the quantity that you want to order, and click Add to Cart.\nAdding Multiple Customer Catalog Items to the\nShopping Cart\nProcedure', page_no=8, section=None, title=None), DocumentChunk(chunk_id=UUID('ffb88af2-1e39-4e89-997a-1ea3a500ddf6'), chunk_index=48, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27578, tzinfo=datetime.timezone.utc), text='Select the check box for each item you want to add, then click Add to Cart.\nAdding Partial Items to the Shopping Cart\nPrerequisites\nThe feature to add multiple partial items at once is not enabled in the default configuration. To enable this\nfeature, contact your Designated Support Contact to log a service request and an SAP Ariba Customer Support\nrepresentative will contact you.', page_no=8, section=None, title=None), DocumentChunk(chunk_id=UUID('3758e7fe-6ba0-4584-b40b-953a127fec24'), chunk_index=49, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27582, tzinfo=datetime.timezone.utc), text='If a partial item has more than eight attributes, the additional details pop-up is not displayed. You enter additional\nitem details on the Enter Item Information page that is displayed.\nProcedure\n1.\nFind the item you want to add.\n2. On the search results page, click Add to Cart.\n3. In the pop-up window that appears or on the Enter Item Information page, specify additional details, and click\nAdd.', page_no=8, section=None, title=None), DocumentChunk(chunk_id=UUID('28224c69-2f27-4c28-8278-e713babc40ce'), chunk_index=50, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27585, tzinfo=datetime.timezone.utc), text='PunchOut Items\nDepending on your customer catalog configuration, you either punch out to the supplier’s website to search for\nitems (store-level PunchOut), or you search your local customer catalog for items and then punch out to the\nsupplier’s website to add the item to your shopping cart (item-level PunchOut).\nAlternatively, your customer catalog might be configured for a more detailed punch out. For example, if you search', page_no=8, section=None, title=None), DocumentChunk(chunk_id=UUID('98b375d4-dbcc-48d7-8234-9cd46c9394c6'), chunk_index=51, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27589, tzinfo=datetime.timezone.utc), text='the customer catalog for a particular item, and matches are found in a supplier’s PunchOut catalog, you can view\n8\nPUBLIC\nShopping Cart User Guide\nShopping Carts Management', page_no=8, section=None, title=None), DocumentChunk(chunk_id=UUID('97027e37-5a24-4f53-b325-5946f5b7452b'), chunk_index=52, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27685, tzinfo=datetime.timezone.utc), text='the supplier’s PunchOut catalog to see store, aisle, shelf, or item-level results that represent different granularity in\nitem grouping for browsing.\nCustomer catalog items configured for item-level punch out are identified with a Buy from Supplier button on the\ncustomer catalog search results page. When you click the button, you punch out to the supplier’s website and can\nplace your order there.', page_no=9, section=None, title=None), DocumentChunk(chunk_id=UUID('81310ca2-c2ea-4b59-bd3c-0a24a5c2c915'), chunk_index=53, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27690, tzinfo=datetime.timezone.utc), text='What you see on the supplier’s website depends on the supplier, but when you have selected your items, added\nthem to the supplier’s shopping cart, and checked them out, the selected items are shown in SAP Ariba Catalog.\nHelpful Hints for Adding PunchOut Items\n•\nWhen you punch out to a supplier’s site, you can click Close PunchOut Catalog Shopping Session in the', page_no=9, section=None, title=None), DocumentChunk(chunk_id=UUID('24f10408-59b3-4b05-953b-2bef3a208e70'), chunk_index=54, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27694, tzinfo=datetime.timezone.utc), text='upper right of the page to exit the supplier site without adding an item to your shopping cart.\n•\nIn the customer catalog search results page, you cannot add multiple item-level PunchOut items to your\nshopping cart in one transaction by selecting multiple items and clicking Add to Cart. However, depending on', page_no=9, section=None, title=None), DocumentChunk(chunk_id=UUID('4976ce3d-d62f-427b-946c-4ca7ff970e49'), chunk_index=55, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27697, tzinfo=datetime.timezone.utc), text='how your customer catalog is configured, you might be able to add multiple items by using PunchOut to access\nyour supplier’s website, searching for items and then adding them to the shopping cart.\nNon-Catalog Items\nWhen you add a non-catalog item you will need to provide the following information:\nOption\nRequired Action\nFull Description\nEnter a description of the item.\nCommodity Code', page_no=9, section=None, title=None), DocumentChunk(chunk_id=UUID('f25ae93c-6c15-4e75-8e19-2378672c8292'), chunk_index=56, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27701, tzinfo=datetime.timezone.utc), text='Select a commodity code from the available choices, or click Search for more to select a\ndifferent commodity code.\nQuantity\nEnter the quantity of the new item you are adding.\nUnit of Measure\nSelect a unit of measure from the available choices, or click Search for more to select a\ndifferent unit of measure.\nPrice', page_no=9, section=None, title=None), DocumentChunk(chunk_id=UUID('c992acbc-940d-4a5d-963b-07385a53dd09'), chunk_index=57, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27705, tzinfo=datetime.timezone.utc), text='Enter the item price, or an estimated price. The total value of the shopping cart determines\nthe default approvers, who must have a price to approve the request.\nIf you change the price or quantity, click Update Total to update the shopping cart total\nSelect a currency from the available choices, or click Other to select a different currency.\nAmount', page_no=9, section=None, title=None), DocumentChunk(chunk_id=UUID('c773a903-0e74-4b02-9f18-6e1825fd9ef9'), chunk_index=58, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27709, tzinfo=datetime.timezone.utc), text='This is a read-only field that is updated when you click Update Total.\nAdditional Pricing Details\nEnter additional pricing details if required. For more information on advanced pricing details,\nsee Advanced Pricing Details and Fields.\nShopping Cart User Guide\nShopping Carts Management\nPUBLIC\n9', page_no=9, section=None, title=None), DocumentChunk(chunk_id=UUID('6a329184-2451-4d15-998d-ccc27baee417'), chunk_index=59, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27768, tzinfo=datetime.timezone.utc), text='Option\nRequired Action\nSupplier\nSelect a supplier from the available choices, or click Search for more to select a different\nsupplier.\nIf available, select a supplier configured as a preferred supplier for the selected commodity\ncode. A value of Yes in the Preferred Supplier column indicates that the supplier is config-\nured as a preferred supplier.\nContact\nThe value for this field changes depending on the supplier you choose.', page_no=10, section=None, title=None), DocumentChunk(chunk_id=UUID('a3cb53cf-e795-49a5-8f9d-5366d1f9b202'), chunk_index=60, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27772, tzinfo=datetime.timezone.utc), text='Click the contact name to see details for that person.\nClick select to select another contact for the supplier you chose.\nSupplier Part Number\nEnter the Supplier Part Number for the item.\nSupplier Auxiliary Part ID\nEnter the Supplier Auxiliary Part ID for the item.\nAdding a Non-Catalog Item\nPrerequisites', page_no=10, section=None, title=None), DocumentChunk(chunk_id=UUID('d3ec6341-c644-4f8b-9691-1383a6cecc38'), chunk_index=61, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27777, tzinfo=datetime.timezone.utc), text='You must not belong to the No Ad-hoc Item group in order to see the Create Non-Catalog Item button and add\nnon-catalog items to shopping carts.\nIf you can’t find what you need in the customer catalog, you can create non-catalog items by describing what you\nneed so that a purchasing agent can locate and order the items for you.\nProcedure\n1.', page_no=10, section=None, title=None), DocumentChunk(chunk_id=UUID('cb685af6-baf8-4c98-b147-caa7800ee0b0'), chunk_index=62, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27780, tzinfo=datetime.timezone.utc), text='On the customer catalog home page, click + Non-Catalog Item. If you are in the customer catalog home page,\nor the customer catalog search results page, click Create Non-Catalog Item.\n2. Enter the non-catalog item information in the fields provided. For additional information, see About Adding\nNon-Catalog Items [page 9].\n3. Click OK. The item is added to your shopping cart.\n10\nPUBLIC\nShopping Cart User Guide\nShopping Carts Management', page_no=10, section=None, title=None), DocumentChunk(chunk_id=UUID('07cd9e91-24c3-4a64-8485-f549f3fa1783'), chunk_index=63, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27847, tzinfo=datetime.timezone.utc), text='Editing Shopping Cart Line Items\nYou can edit line item properties and details, such as order quantity, supplier, or item description for an item from\nthe Shopping Cart page. The attributes you can edit depend on the type of item:\n•\nFor customer catalog items, you can edit the order quantity.\n•\nFor non-catalog items, you can edit all of the item’s properties you specified when you added the item.', page_no=11, section=None, title=None), DocumentChunk(chunk_id=UUID('6ebd158d-125c-46f2-875f-4b78daa061d3'), chunk_index=64, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27851, tzinfo=datetime.timezone.utc), text='•\nFor partial items, you can edit the quantity and any additional item details required to place the order.\nRelated Information\nHow to Edit and Review Line Item Properties [page 11]\nHow to Edit Additional Line Item Details for Partial Items [page 11]\nPunchOut Items Editing [page 13]\nHow to Edit and Review Line Item Properties\nProcedure\n1.', page_no=11, section=None, title=None), DocumentChunk(chunk_id=UUID('af5d313a-1f9d-4b7b-8b9b-5c238ec0a8da'), chunk_index=65, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27854, tzinfo=datetime.timezone.utc), text='From the Shopping Cart page, click the check box for the item you want to edit, then click Edit.\n2. On the Edit Line Item page, review and edit the item as needed.\n3. Do one of the following:\n1.\nClick OK to save the change and return to the previous screen.\n2. Click Cancel to return to the previous screen without saving changes.', page_no=11, section=None, title=None), DocumentChunk(chunk_id=UUID('ceeae15a-7ef8-4d1b-8298-3e116e25f2ce'), chunk_index=66, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27858, tzinfo=datetime.timezone.utc), text='How to Edit Additional Line Item Details for Partial\nItems\nProcedure\n1.\nFrom the Shopping Cart page, click the check box for the partial item you want to edit, then click Edit.\n2. On the Edit Additional Item Details page, enter information specific to the item you are ordering, such as\nprice, unit of measure, your direct phone, URL, translation, title or position, E-mail address, whether to include', page_no=11, section=None, title=None), DocumentChunk(chunk_id=UUID('19a53830-e47e-499f-952b-3306792910e6'), chunk_index=67, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27862, tzinfo=datetime.timezone.utc), text='a logo on the item, fax number, first and last name.\nShopping Cart User Guide\nEditing Shopping Cart Line Items\nPUBLIC\n11', page_no=11, section=None, title=None), DocumentChunk(chunk_id=UUID('8eabdd9d-7e69-411d-90b6-9735cb2f794c'), chunk_index=68, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27925, tzinfo=datetime.timezone.utc), text='3. Do one of the following:\n1.\nClick OK, then click Save to associate the additional line item details with your order.\n2. Click Cancel to return to the Shopping Cart without saving your changes.\nHow to Delete Items from the Shopping Cart\nProcedure\nOn the shopping cart summary page, mark the check boxes for the items that you want to delete and click Delete.\nDeletion of PunchOut Items', page_no=12, section=None, title=None), DocumentChunk(chunk_id=UUID('400f8bd6-ac64-4911-8c17-0680375e3787'), chunk_index=69, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27929, tzinfo=datetime.timezone.utc), text='Deleting PunchOut items might affect the cost of other PunchOut items added to your shopping cart. For example,\nif you order two items with an agreement that if you buy one you get the second at a 50% discount, and then you\ndelete one, the cost of the other item must be calculated differently.', page_no=12, section=None, title=None), DocumentChunk(chunk_id=UUID('2965fd65-135e-4bfd-8bbe-784c72c84f79'), chunk_index=70, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27933, tzinfo=datetime.timezone.utc), text='If you want to delete only a portion of the PunchOut items from a supplier, you need to do that from the supplier’s\nwebsite. A confirmation message is not issued before the items are deleted.\nDeleting All PunchOut Items\nProcedure\nOn the shopping cart Summary page, select the check box for all items from that supplier, then click Delete.\nDeleting Selected PunchOut Items\nProcedure\n1.', page_no=12, section=None, title=None), DocumentChunk(chunk_id=UUID('880241fa-5a2b-418f-8c20-2e330568af0d'), chunk_index=71, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27937, tzinfo=datetime.timezone.utc), text='On the shopping cart Summary page, select the check box for the item you want to delete, then click Delete.\n2. On the Delete Line Item page, click one of the following:\n•\nDelete to delete all items from this supplier\n•\nEdit to punch out to the supplier’s website where you can delete selected items from your shopping cart\n•', page_no=12, section=None, title=None), DocumentChunk(chunk_id=UUID('49be2828-f352-4836-814b-edbd26270a9c'), chunk_index=72, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27941, tzinfo=datetime.timezone.utc), text='Cancel to cancel the action and return to your shopping cart.\n12\nPUBLIC\nShopping Cart User Guide\nEditing Shopping Cart Line Items', page_no=12, section=None, title=None), DocumentChunk(chunk_id=UUID('4506e83e-54b5-490c-8895-82f397a57e53'), chunk_index=73, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27971, tzinfo=datetime.timezone.utc), text='PunchOut Items Editing\nYour company might have agreements with suppliers for discounts on items from the suppliers’ customer catalogs.\nTo change PunchOut items in your shopping cart, you must return to the suppliers’ website, since changes may\naffect the discounts applied to the final orders.\nEditing PunchOut Items\nProcedure\n1.\nOn the shopping cart Summary page, click the check box for the item you want to edit and click Edit.', page_no=13, section=None, title=None), DocumentChunk(chunk_id=UUID('1aa39c6a-bbab-4f00-9a1e-8e47344c76e1'), chunk_index=74, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 27975, tzinfo=datetime.timezone.utc), text='2. On the item review page, click the Edit this PunchOut catalog item link.\n3. Make your changes on the supplier’s website and return to the shopping cart in SAP Ariba Catalog.\nShopping Cart User Guide\nPunchOut Items Editing\nPUBLIC\n13', page_no=13, section=None, title=None), DocumentChunk(chunk_id=UUID('b4575b7a-6d88-4bcb-a725-6c07a7ea3d56'), chunk_index=75, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28071, tzinfo=datetime.timezone.utc), text='Line Items Mass Edit\nYou use mass editing when you are attempting to edit multiple line items at the same time. This is useful when you\nneed to make the same change to multiple line items.\nWhen you select multiple line items for mass edit, the fields with their values displayed are from a sample line', page_no=14, section=None, title=None), DocumentChunk(chunk_id=UUID('f0e0c500-1126-48f0-9515-7245161677f8'), chunk_index=76, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28075, tzinfo=datetime.timezone.utc), text='item that is selected from the shopping cart. SAP Ariba Catalog selects a sample line item based on its restrictive\ncharacteristics. That is, if the shopping cart contains a PunchOut line, a customer catalog, and a non-catalog line\nitem, it selects the PunchOut line item as the sample. If there are line items of only one kind (that is, all PunchOut,', page_no=14, section=None, title=None), DocumentChunk(chunk_id=UUID('f8dd7ec5-ee25-4909-9008-0efa88841b87'), chunk_index=77, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28079, tzinfo=datetime.timezone.utc), text='or all customer catalog lines items), then the first line item among the selected lines becomes the sample line item.\nWhen you make changes in this page, only those changes to the selected fields get propagated to the rest of the\nline items that are chosen for mass edit. The unchanged field values in this page do not get propagated to the other\nline items.', page_no=14, section=None, title=None), DocumentChunk(chunk_id=UUID('f6d1a6f0-ab41-4b35-80c9-490cd232e257'), chunk_index=78, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28083, tzinfo=datetime.timezone.utc), text='If the change you make to a field is not valid, the error message appears immediately on input, but this validation\ncheck does not stop you from completing the mass edit operation.\nAll validation checks are performed based on the field values in the sample line item only. That is, if for example,', page_no=14, section=None, title=None), DocumentChunk(chunk_id=UUID('7d43f3b0-89f8-4fb6-badf-c57f96405035'), chunk_index=79, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28087, tzinfo=datetime.timezone.utc), text='you made a change to a field that is dependent/associated to another field (say you change the Business Unit value\nthat is associated to a specific Cost Center); the validation check determines whether this change is valid with\nrespect to the Cost Center value that exists in the sample line item only. But, this change may not be valid for other', page_no=14, section=None, title=None), DocumentChunk(chunk_id=UUID('e4875d4c-967d-4d22-bd01-979b00ef6f4e'), chunk_index=80, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28090, tzinfo=datetime.timezone.utc), text='selected line items. Such possible errors are not displayed during the mass edit phase.\nMass Editing a Shopping Cart\nPrerequisites\nThe Line Item Details section is not displayed if the selected line items contain services items.\nYou cannot mass edit line item details if your selection contains a combination of goods and services items.\nProcedure\n1.', page_no=14, section=None, title=None), DocumentChunk(chunk_id=UUID('fc4d29e2-92e8-49a1-a3a5-6675ee1dba8c'), chunk_index=81, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28094, tzinfo=datetime.timezone.utc), text='On the shopping cart summary page, mark the checkboxes against the line items that you want to edit or mark\nthe Select All checkbox to select all the line items.\n\ue05c\xa0Note\nSelecting a customer catalog kit header line item automatically selects all the kit items and any changes\nmade are applied to all the items in the kit.', page_no=14, section=None, title=None), DocumentChunk(chunk_id=UUID('b08e0772-7ff2-4fc3-82f9-5431580b86b5'), chunk_index=82, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28098, tzinfo=datetime.timezone.utc), text='2. Click Edit. The mass edit page displays the Line Item Details section.\n14\nPUBLIC\nShopping Cart User Guide\nLine Items Mass Edit', page_no=14, section=None, title=None), DocumentChunk(chunk_id=UUID('2e25f4cf-a48b-4561-9754-14d8c82d0d77'), chunk_index=83, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28148, tzinfo=datetime.timezone.utc), text='3. Click Next after making the necessary changes. The review page displays the changed fields and their values.\nThe changes made to each field are applicable to all the selected line items.\n4. Click Done to save your changes and return to the shopping cart summary page.\nMass Editing of Partial Items\nPrerequisites\nPartial items must belong to the same Type in order to be mass edited.\n\ue094\xa0Restriction', page_no=15, section=None, title=None), DocumentChunk(chunk_id=UUID('0344679a-15f5-420d-8f48-8d3c96f4b95d'), chunk_index=84, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28152, tzinfo=datetime.timezone.utc), text='The Additional Line Item Details section only appears if you have selected two or more partial items of the\nsame type.\nProcedure\nOn the shopping cart summary page, select partial items belonging to the same Type, and click Edit.\nMass Editing Collaboration Options in a Shopping\nCart for Goods Items\nPrerequisites\nYou must be a member of the Dynamic Collaboration User group to see the Collaboration radio button on the', page_no=15, section=None, title=None), DocumentChunk(chunk_id=UUID('977332b3-34ef-405d-9e82-034094795016'), chunk_index=85, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28156, tzinfo=datetime.timezone.utc), text='mass edit page. The Collaboration radio button must be configured to be mass editable.\nWhen all items you select are goods items, the Collaboration radio button is displayed on the mass edit page.\n\ue05c\xa0Note\nThe Collaboration radio button is not displayed if the collaboration property of the selected items is a\ncombination of Required, Allowed, or Disallowed.\nShopping Cart User Guide\nLine Items Mass Edit\nPUBLIC\n15', page_no=15, section=None, title=None), DocumentChunk(chunk_id=UUID('c6c85a65-1d68-4165-a288-09530f054e6f'), chunk_index=86, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28201, tzinfo=datetime.timezone.utc), text='Procedure\n1.\nOn the shopping cart summary page, mark the check boxes against the goods line items that you want to edit\nor mark the Select All check box to select all the line items.\n2. Click Edit. The mass edit page displays the Collaboration radio button in the Line Item Details section.', page_no=16, section=None, title=None), DocumentChunk(chunk_id=UUID('01757d01-d976-4339-bf89-7811a41788a5'), chunk_index=87, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28205, tzinfo=datetime.timezone.utc), text='3. Select Yes to make all the selected items collaborative or select No to make all the items non-collaborative. The\nselection is applied to all the line items only if you make a change to the Collaboration radio button.\n4. If you select Yes, the Invited Suppliers dialog box is displayed.', page_no=16, section=None, title=None), DocumentChunk(chunk_id=UUID('e7778f48-ae04-46c5-a2d9-a4f7f715b71a'), chunk_index=88, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28209, tzinfo=datetime.timezone.utc), text='5. Click Change to add or remove suppliers. Clicking Add to invite more suppliers will display a list of all the\navailable suppliers in the system.\n6. Click Next after making the necessary changes. The review page displays the changed fields and their values.\nThe changes made to each field are applicable to all the selected line items.\n7.', page_no=16, section=None, title=None), DocumentChunk(chunk_id=UUID('d68811d1-c541-441a-9ff4-b3a85eb3305d'), chunk_index=89, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28213, tzinfo=datetime.timezone.utc), text='Click Done to save your changes and return to the shopping cart summary page.\nThe edited field values are validated and an error message is displayed against the line items that contain\ninvalid values. Edit each line item individually to rectify the errors.\n16\nPUBLIC\nShopping Cart User Guide\nLine Items Mass Edit', page_no=16, section=None, title=None), DocumentChunk(chunk_id=UUID('a1711580-9223-4115-af49-982036a0cf19'), chunk_index=90, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28219, tzinfo=datetime.timezone.utc), text='Checking Out the Shopping Cart\nContext\nAfter you have added items to your shopping cart, you check out the shopping cart to your external procurement\nsystem.\nProcedure\nOn the shopping cart summary page, click Checkout.\nShopping Cart User Guide\nChecking Out the Shopping Cart\nPUBLIC\n17', page_no=17, section=None, title=None), DocumentChunk(chunk_id=UUID('e75083cb-ece0-47b2-ac60-38b4fa4a0a0d'), chunk_index=91, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28248, tzinfo=datetime.timezone.utc), text='Saving a Shopping Cart\nContext\nAfter you have finished adding items to your shopping cart, you can return to your external procurement system\nwith the shopping cart or choose to save it in SAP Ariba Catalog. You can later return to SAP Ariba Catalog, access\nyour saved shopping carts from the saved shopping carts page, and complete the shopping process.\nProcedure\n1.', page_no=18, section=None, title=None), DocumentChunk(chunk_id=UUID('3b7db704-6a6c-407a-81f5-d2dbcd1b554e'), chunk_index=92, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28252, tzinfo=datetime.timezone.utc), text='On the shopping cart summary page, click Close Cart.\n2. Click Save to save the cart and return to the customer catalog home page.\n18\nPUBLIC\nShopping Cart User Guide\nSaving a Shopping Cart', page_no=18, section=None, title=None), DocumentChunk(chunk_id=UUID('aaf7482f-5f4f-47a5-8078-447e43d827a7'), chunk_index=93, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28313, tzinfo=datetime.timezone.utc), text='Finding a Saved Shopping Cart\nContext\nYou can use filters when searching for saved shopping carts. Not all search filters are displayed by default; you can\nadd and remove filters as needed.\nProcedure\n1.\nPunch in to SAP Ariba Catalog and click the Saved Carts button.\n2. Locate or search for the shopping cart using the search filters.\n3. Select the shopping cart and click Edit.', page_no=19, section=None, title=None), DocumentChunk(chunk_id=UUID('c4552afd-046b-43fc-b492-f534ce2e89bd'), chunk_index=94, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28317, tzinfo=datetime.timezone.utc), text='The shopping cart summary page is displayed.\nShopping Cart Search Filters\nSearch Filter\nDescription\nDate Created\nThe date the shopping cart was created. You can select any one of the available options\nor select Custom and enter a From and To date.\nDescription (any line item)\nDescription of any line item.\nID\nThe shopping cart ID.\nNon-Catalog Item (any line item)', page_no=19, section=None, title=None), DocumentChunk(chunk_id=UUID('6997eb98-7849-42be-832e-930a28cfa81c'), chunk_index=95, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28321, tzinfo=datetime.timezone.utc), text='Select wether you want to search for shopping carts that contain non-catalog items or\nnot.\nOn Behalf Of\nThe name of the user on whose behalf the shopping cart was created. Click Select and\nthen select a user from the list.\nPreparer\nThe name of the user that created the shopping cart.Click Select and then select a user\nfrom the list.\nPrice (any line item)', page_no=19, section=None, title=None), DocumentChunk(chunk_id=UUID('d57b7f9e-8744-4886-ae3a-5a1785435ea7'), chunk_index=96, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28325, tzinfo=datetime.timezone.utc), text='The price of any one of the line items that is within a specified range. Enter values for the\nprice range.\nShopping Cart Name\nThe name of the shopping cart.\nStatus\nThe status of the shopping cart.\nSupplier (any line item)\nThe supplier of any one of the line items. Click Select and select supplier from the list.\nTotal Cost', page_no=19, section=None, title=None), DocumentChunk(chunk_id=UUID('dd7bee36-b991-4d5f-ac72-0ce1145bcb44'), chunk_index=97, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28329, tzinfo=datetime.timezone.utc), text='The total cost of the shopping cart that is within the specified range.Enter values for the\ntotal cost range.\nShopping Cart User Guide\nFinding a Saved Shopping Cart\nPUBLIC\n19', page_no=19, section=None, title=None), DocumentChunk(chunk_id=UUID('bba26d46-57f7-4004-ae0e-206d5600f149'), chunk_index=98, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28364, tzinfo=datetime.timezone.utc), text='Copying a Saved Shopping Cart\nContext\nIf an item in a shopping cart contains a default price from the customer defined field (CDF), even if that price is $0,\nthen that CDF price is copied to the shopping cart. If a default price is not specified in the CDF, the price from the', page_no=20, section=None, title=None), DocumentChunk(chunk_id=UUID('82e59ef6-96da-4583-b7fa-ebc5d588fc5c'), chunk_index=99, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28368, tzinfo=datetime.timezone.utc), text='original shopping cart is copied over to the new shopping cart. This price is what the supplier sees when viewing a\ncollaboration request, unless it is changed by the buyer when creating a requisition.\nProcedure\n1.\nPunch in to SAP Ariba Catalog and click the Saved Carts button.\n2. Locate or search for the shopping cart using the search filters.', page_no=20, section=None, title=None), DocumentChunk(chunk_id=UUID('0cbda49f-8ea5-499e-8c44-183a7d216f72'), chunk_index=100, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28372, tzinfo=datetime.timezone.utc), text='3. Select the shopping cart that you want to make a copy of and click Copy.\n4. A copy of the selected shopping cart is created and added to the Saved Shopping Carts list.\n5. Select the new shopping cart and click Edit to open the cart.\n20\nPUBLIC\nShopping Cart User Guide\nCopying a Saved Shopping Cart', page_no=20, section=None, title=None), DocumentChunk(chunk_id=UUID('3dc9becd-c114-4ea0-a120-79f69594fce5'), chunk_index=101, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28378, tzinfo=datetime.timezone.utc), text='Deleting a Saved Shopping Cart\nProcedure\n1.\nPunch in to SAP Ariba Catalog and click the Saved Carts button.\n2. Locate or search for the shopping cart using the search filters.\n3. Select the shopping cart and click Delete.\nShopping Cart User Guide\nDeleting a Saved Shopping Cart\nPUBLIC\n21', page_no=21, section=None, title=None), DocumentChunk(chunk_id=UUID('6eeb98ac-cb34-416c-a370-86dc1482df4e'), chunk_index=102, chunking_version=1, document_id=UUID('44518d84-4b61-4b00-972e-946ef9384351'), document_group_id=UUID('b77efca4-2f58-4b79-b2a5-fda6ccd5843e'), is_active=True, created_at=datetime.datetime(2026, 8, 27, 18, 34, 6, 28486, tzinfo=datetime.timezone.utc), text='Importan